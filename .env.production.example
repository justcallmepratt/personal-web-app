# Production Environment Variables
# Copy this file to .env.production and fill in your values

## Database Configuration
DB_NAME=personal_web_app
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_PORT=5432

## Backend Configuration
SPRING_PROFILES_ACTIVE=production
JWT_SECRET=your-jwt-secret-key-min-32-chars
ADMIN_PASSWORD_HASH=$2a$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LewdBPj8lLxKQZK.

## Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

## CORS Configuration
CORS_ORIGIN=https://your-frontend-domain.com

## Frontend Configuration
NEXT_PUBLIC_API_URL=https://your-backend-domain.com
NEXT_PUBLIC_SITE_NAME=V // Night City Dev
NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.com

## GitHub Container Registry (GHCR)
## These are optional - used if pulling private images
GHCR_USERNAME=justcallmepratt
GHCR_TOKEN=ghp_your-github-token-here

## Postgres Image (optional override)
# POSTGRES_IMAGE=postgres:16-alpine
