# Copy this file to .env and fill in values before running docker compose.
# Never commit .env — it is gitignored.

# ── Database ───────────────────────────────────────────────────────────────────
# For Docker Compose local dev (supabase-db container):
SUPABASE_DB_PASSWORD=your-supabase-db-password

# For the Spring Boot docker profile (set SPRING_PROFILES_ACTIVE=docker; docker compose does
# this itself). Production uses the
# Supabase session pooler here; see docs/DEPLOYMENT.md.
# Profiles: dev (default; Supabase via SUPABASE_DB_PASSWORD), docker, test (H2).
# SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:postgresql://supabase-db:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password

# Connection pool size (default: 10 for docker, 5 for dev)
DB_POOL_SIZE=10

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRY_MS=86400000

# ── Admin ──────────────────────────────────────────────────────────────────────
# Generate hash: htpasswd -bnBC 12 "" "yourpassword" | tr -d ':\n'
ADMIN_USERNAME=admin
# Leave empty until you generate one; do not reuse a hash from the internet.
ADMIN_PASSWORD_HASH=

# ── Email (optional — leave blank to disable; messages still saved to DB) ──────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
CONTACT_NOTIFY_TO=your-email@gmail.com

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
CORS_ORIGIN=http://localhost:3000

# ── Contact rate limit (Spring API and the frontend's standalone handler) ─────
# Defaults: 3 submissions per 3600 seconds, per address.
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW=3600

# ── Frontend ───────────────────────────────────────────────────────────────────
# Content comes from frontend/src/content by default. Set BACKEND_URL (server-only)
# only if the frontend should read from an HTTP API instead, e.g. the Spring Boot
# service. The contact form uses MAIL_* / CONTACT_NOTIFY_TO above (see docs/DEPLOYMENT.md).
# BACKEND_URL=http://localhost:8080
# Base URL of the Kafka demo service for /projects/kafka (server-only). Unset = demo shown as offline.
# KAFKA_DEMO_URL=http://localhost:8081
# Must match the service's DEMO_API_TOKEN when it has one.
# KAFKA_DEMO_TOKEN=
# GitHub activity section on the home page (server-only, both optional). The site works
# without either: GITHUB_USERNAME defaults to justcallmepratt, and no token is needed at
# one request an hour. A token (fine-grained, read-only, public repositories) only raises
# GitHub's 60 requests/hour per-IP limit. Never prefix these with NEXT_PUBLIC_.
# GITHUB_USERNAME=justcallmepratt
# GITHUB_TOKEN=
NEXT_PUBLIC_SITE_NAME=V // Night City Dev
NEXT_PUBLIC_SITE_URL=https://justcallmepratt.dev
