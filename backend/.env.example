# Copy to .env and fill in. .env is gitignored.
# Variable names come from backend/src/main/resources/application*.yml.
# Full production list: docs/DEPLOYMENT.md.

# ── Spring profile ─────────────────────────────────────────────────────────────
# dev    (default when unset)  Supabase Postgres via SUPABASE_DB_PASSWORD below
# docker (docker compose, Railway)  datasource from SPRING_DATASOURCE_*
# test   H2 in memory (used by tests)
# SPRING_PROFILES_ACTIVE=dev

# ── Database: dev profile ──────────────────────────────────────────────────────
SUPABASE_DB_PASSWORD=
# Default host is the direct db.<ref>.supabase.co, which is IPv6-only on the free plan.
# SPRING_DATASOURCE_USERNAME defaults to postgres.

# ── Database: docker profile (Railway) ─────────────────────────────────────────
# Supabase session pooler (Dashboard → Connect → Session pooler, port 5432):
# SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
# SPRING_DATASOURCE_PASSWORD=<database password>
# DB_POOL_SIZE=5        # default 5 (dev) / 10 (docker); the pooler caps free-plan connections

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRY_MS=86400000
ADMIN_USERNAME=admin
# Generate: htpasswd -bnBC 12 "" "yourpassword" | tr -d ':\n'
ADMIN_PASSWORD_HASH=

# ── Email (optional; messages are saved to the DB regardless) ──────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# Defaults to MAIL_USER
CONTACT_NOTIFY_TO=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
CORS_ORIGIN=http://localhost:3000
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW=3600
